		{"kind":"line","file":"src/cli/grep-cli.ts","en":"\tconsole.log(`${chalk.bold(`${APP_NAME} grep`)} - Test grep tool","zh":"\tconsole.log(`${chalk.bold(`${APP_NAME} grep`)} - 测试 grep 工具"},
		{"kind":"string","file":"src/cli/grep-cli.ts","en":"Usage:","zh":"用法:"},
		{"kind":"string","file":"src/cli/grep-cli.ts","en":"Arguments:","zh":"参数:"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  pattern   Regex pattern to search for","zh":"  pattern   要搜索的正则模式"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  path      Directory or file to search (default: .)","zh":"  path      要搜索的目录或文件(默认:.)"},
		{"kind":"string","file":"src/cli/grep-cli.ts","en":"Options:","zh":"选项:"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -g, --glob <pattern>  Filter files by glob pattern","zh":"  -g, --glob <pattern>  按 glob 模式过滤文件"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -l, --limit <n>       Max matches (default: 20)","zh":"  -l, --limit <n>       最大匹配数(默认:20)"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -C, --context <n>     Context lines (default: 2)","zh":"  -C, --context <n>     上下文行数(默认:2)"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -f, --files           Output file names only","zh":"  -f, --files           仅输出文件名"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -c, --count           Output match counts per file","zh":"  -c, --count           输出每个文件的匹配数"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  -h, --help            Show this help","zh":"  -h, --help            显示本帮助"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  --no-gitignore        Include files excluded by .gitignore","zh":"  --no-gitignore        包含被 .gitignore 排除的文件"},
		{"kind":"string","file":"src/cli/grep-cli.ts","en":"Environment:","zh":"环境变量:"},
		{"kind":"line","file":"src/cli/grep-cli.ts","en":"  PI_WALK_WORKERS=N    Set filesystem walker workers (default 4, 0 = auto)","zh":"  PI_WALK_WORKERS=N    设置文件系统遍历 worker 数(默认 4,0 = 自动)"},
		{"kind":"string","file":"src/cli/grep-cli.ts","en":"Examples:","zh":"示例:"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"Environment Variables:","zh":"环境变量:"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"# Core Providers","zh":"# 核心提供商"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_API_KEY          - Anthropic Claude models","zh":"  ANTHROPIC_API_KEY          - Anthropic Claude 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_OAUTH_TOKEN      - Anthropic OAuth (takes precedence over API key)","zh":"  ANTHROPIC_OAUTH_TOKEN      - Anthropic OAuth(优先于 API 密钥)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  CLAUDE_CODE_USE_FOUNDRY    - Enable Anthropic Foundry mode (uses Foundry endpoint + mTLS)","zh":"  CLAUDE_CODE_USE_FOUNDRY    - 启用 Anthropic Foundry 模式(使用 Foundry 端点 + mTLS)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  FOUNDRY_BASE_URL           - Anthropic Foundry base URL (e.g., https://<foundry-host>)","zh":"  FOUNDRY_BASE_URL           - Anthropic Foundry 基础 URL(如 https://<foundry-host>)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_FOUNDRY_API_KEY  - Anthropic token used as Authorization: Bearer <token> in Foundry mode","zh":"  ANTHROPIC_FOUNDRY_API_KEY  - Foundry 模式下用作 Authorization: Bearer <token> 的 Anthropic token"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_CUSTOM_HEADERS   - Extra headers for Foundry or any custom ANTHROPIC_BASE_URL gateway (e.g., \"user-id: USERNAME\")","zh":"  ANTHROPIC_CUSTOM_HEADERS   - 为 Foundry 或任意自定义 ANTHROPIC_BASE_URL gateway 附加的请求头(如 \"user-id: USERNAME\")"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  CLAUDE_CODE_CLIENT_CERT    - Client certificate (PEM path or inline PEM) for mTLS","zh":"  CLAUDE_CODE_CLIENT_CERT    - mTLS 用的客户端证书(PEM 路径或内联 PEM)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  CLAUDE_CODE_CLIENT_KEY     - Client private key (PEM path or inline PEM) for mTLS","zh":"  CLAUDE_CODE_CLIENT_KEY     - mTLS 用的客户端私钥(PEM 路径或内联 PEM)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  NODE_EXTRA_CA_CERTS        - CA bundle path (or inline PEM) for server certificate validation","zh":"  NODE_EXTRA_CA_CERTS        - 服务器证书校验用的 CA 包路径(或内联 PEM)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  OPENAI_API_KEY             - OpenAI GPT models","zh":"  OPENAI_API_KEY             - OpenAI GPT 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  GEMINI_API_KEY             - Google Gemini models","zh":"  GEMINI_API_KEY             - Google Gemini 模型"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"# Additional LLM Providers","zh":"# 其他 LLM 提供商"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  AZURE_OPENAI_API_KEY       - Azure OpenAI models","zh":"  AZURE_OPENAI_API_KEY       - Azure OpenAI 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  GROQ_API_KEY               - Groq models","zh":"  GROQ_API_KEY               - Groq 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  CEREBRAS_API_KEY           - Cerebras models","zh":"  CEREBRAS_API_KEY           - Cerebras 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  XAI_API_KEY                - xAI Grok models","zh":"  XAI_API_KEY                - xAI Grok 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  OPENROUTER_API_KEY         - OpenRouter aggregated models","zh":"  OPENROUTER_API_KEY         - OpenRouter 聚合模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  KILO_API_KEY               - Kilo Gateway models","zh":"  KILO_API_KEY               - Kilo Gateway 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  MISTRAL_API_KEY            - Mistral models","zh":"  MISTRAL_API_KEY            - Mistral 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ZAI_API_KEY                - z.ai models (ZhipuAI/GLM)","zh":"  ZAI_API_KEY                - z.ai 模型(ZhipuAI/GLM)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  UMANS_AI_CODING_PLAN_API_KEY - Umans AI Coding Plan models","zh":"  UMANS_AI_CODING_PLAN_API_KEY - Umans AI Coding Plan 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  UMANS_WEBSEARCH_PROVIDER    - Umans gateway web search backend (native or exa)","zh":"  UMANS_WEBSEARCH_PROVIDER    - Umans gateway 的 web 搜索后端(native 或 exa)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  MINIMAX_API_KEY            - MiniMax models","zh":"  MINIMAX_API_KEY            - MiniMax 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  OPENCODE_API_KEY           - OpenCode Zen/OpenCode Go models","zh":"  OPENCODE_API_KEY           - OpenCode Zen/OpenCode Go 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  CURSOR_ACCESS_TOKEN        - Cursor AI models","zh":"  CURSOR_ACCESS_TOKEN        - Cursor AI 模型"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  WAFER_SERVERLESS_API_KEY   - Wafer Serverless (pay-as-you-go)","zh":"  WAFER_SERVERLESS_API_KEY   - Wafer Serverless(按量付费)"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"# Cloud Providers","zh":"# 云提供商"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  AWS_PROFILE                - AWS Bedrock (or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)","zh":"  AWS_PROFILE                - AWS Bedrock(或 AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  GOOGLE_CLOUD_PROJECT       - Google Vertex AI (requires GOOGLE_CLOUD_LOCATION)","zh":"  GOOGLE_CLOUD_PROJECT       - Google Vertex AI(需要 GOOGLE_CLOUD_LOCATION)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  GOOGLE_APPLICATION_CREDENTIALS - Service account for Vertex AI","zh":"  GOOGLE_APPLICATION_CREDENTIALS - Vertex AI 的服务账户"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"# Search & Tools","zh":"# 搜索与工具"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  EXA_API_KEY                - Exa web search","zh":"  EXA_API_KEY                - Exa web 搜索"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  BRAVE_API_KEY              - Brave web search","zh":"  BRAVE_API_KEY              - Brave web 搜索"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PERPLEXITY_API_KEY         - Perplexity web search API key (optional; anonymous fallback)","zh":"  PERPLEXITY_API_KEY         - Perplexity web 搜索 API 密钥(可选;匿名回退)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PERPLEXITY_COOKIES         - Perplexity web search (session cookie)","zh":"  PERPLEXITY_COOKIES         - Perplexity web 搜索(session cookie)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  TAVILY_API_KEY             - Tavily web search","zh":"  TAVILY_API_KEY             - Tavily web 搜索"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  TINYFISH_API_KEY           - TinyFish web search","zh":"  TINYFISH_API_KEY           - TinyFish web 搜索"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  FIRECRAWL_API_KEY          - Firecrawl web search","zh":"  FIRECRAWL_API_KEY          - Firecrawl web 搜索"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_SEARCH_API_KEY   - Anthropic web search (override; isolates search from main ANTHROPIC_API_KEY)","zh":"  ANTHROPIC_SEARCH_API_KEY   - Anthropic web 搜索(覆盖;将搜索与主 ANTHROPIC_API_KEY 隔离)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  ANTHROPIC_SEARCH_BASE_URL  - Anthropic web search base URL (override; pairs with ANTHROPIC_SEARCH_API_KEY)","zh":"  ANTHROPIC_SEARCH_BASE_URL  - Anthropic web 搜索基础 URL(覆盖;与 ANTHROPIC_SEARCH_API_KEY 配套)"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"# Configuration","zh":"# 配置"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  OMP_PROFILE                 - Named profile for isolated agent state (same as --profile)","zh":"  OMP_PROFILE                 - 用于隔离 agent 状态的命名 profile(同 --profile)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  Use \\`omp --profile <name> --alias <command>\\` to create a shell shortcut for a profile","zh":"  使用 \\`omp --profile <name> --alias <command>\\` 为 profile 创建 shell 快捷方式"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_CODING_AGENT_DIR        - Session storage directory (default: ~/${CONFIG_DIR_NAME}/agent)","zh":"  PI_CODING_AGENT_DIR        - session 存储目录(默认:~/${CONFIG_DIR_NAME}/agent)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_PACKAGE_DIR             - Override package directory (for Nix/Guix store paths)","zh":"  PI_PACKAGE_DIR             - 覆盖包目录(用于 Nix/Guix store 路径)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_SMOL_MODEL              - Override smol/fast model (see --smol)","zh":"  PI_SMOL_MODEL              - 覆盖 smol/快速模型(参见 --smol)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_SLOW_MODEL              - Override slow/reasoning model (see --slow)","zh":"  PI_SLOW_MODEL              - 覆盖 slow/推理模型(参见 --slow)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_PLAN_MODEL              - Override planning model (see --plan)","zh":"  PI_PLAN_MODEL              - 覆盖规划模型(参见 --plan)"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  PI_NO_PTY                  - Disable PTY-based interactive bash execution","zh":"  PI_NO_PTY                  - 禁用基于 PTY 的交互式 bash 执行"},
		{"kind":"line","file":"src/cli/help-extra.ts","en":"  For complete environment variable reference, see:","zh":"  完整的环境变量参考见:"},
		{"kind":"string","file":"src/cli/help-extra.ts","en":"Available Tools (default-enabled unless noted):","zh":"可用工具(除非注明,默认启用):"},
