		{"kind":"string","file":"src/cli/command-help.ts","en":"Download tiny local models (session titles + memory)","zh":"下载本地小模型(会话标题 + 记忆)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Get the API key or OAuth token for a provider","zh":"获取某提供商的 API 密钥或 OAuth 令牌"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Inspect and test Time-Traveling Stream Rules (TTSR)","zh":"检查并测试时间旅行流规则(TTSR)"},
