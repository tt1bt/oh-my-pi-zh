		{"kind":"string","file":"src/cli/command-help.ts","en":"List or clear agent-managed git worktrees (~/.omp/wt)","zh":"列出或清理代理管理的 git 工作树(~/.omp/wt)"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"\tconsole.log(`${chalk.bold(`${APP_NAME} config`)} - Manage settings","zh":"\tconsole.log(`${chalk.bold(`${APP_NAME} config`)} - 管理设置"},
		{"kind":"string","file":"src/cli/config-cli.ts","en":"Commands:","zh":"命令:"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  list               List all settings with current values","zh":"  list              列出所有设置及其当前值"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  get <key>          Get a specific setting value","zh":"  get <key>         获取指定设置的值"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  set <key> <value>  Set a setting value","zh":"  set <key> <value> 设置某个设置的值"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  reset <key>        Reset a setting to its default value","zh":"  reset <key>       将设置重置为默认值"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  path               Print the config directory path","zh":"  path              打印配置目录路径"},
		{"kind":"line","file":"src/cli/config-cli.ts","en":"  init-xdg           Initialize XDG Base Directory structure","zh":"  init-xdg          初始化 XDG Base Directory 结构"},
		{"kind":"string","file":"src/cli/config-cli.ts","en":"Options:","zh":"选项:"},
