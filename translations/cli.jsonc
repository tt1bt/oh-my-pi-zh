		{"kind":"string","file":"src/cli/command-help.ts","en":"View, clean, or push reported tool issues (auto-QA grievances)","zh":"查看、清理或上报工具问题(自动 QA 投诉)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Install or link an extension package (alias of `plugin install`/`plugin link`)","zh":"安装或链接扩展包(`plugin install`/`plugin link` 的别名)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Join a shared collab session (same as /join)","zh":"加入共享协作会话(同 /join)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"List, search, and refresh available models","zh":"列出、搜索并刷新可用模型"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Manage plugins (install, uninstall, list, etc.)","zh":"管理插件(安装、卸载、列出等)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Show what the read tool will return for a path, URL, or internal URI","zh":"预览 read 工具对路径、URL 或内部 URI 的返回内容"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Synthesize text with the local TTS engine and play it through the speakers","zh":"用本地 TTS 引擎合成文本并通过扬声器播放"},
