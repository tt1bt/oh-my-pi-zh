{
	"entries": [
		{"kind":"template","file":"src/cli/args.ts","en":"${chalk.bold(APP_NAME)} - AI coding assistant\\n\\n","zh":"${chalk.bold(APP_NAME)} - AI 编程助手\\n\\n"},
		{"kind":"template","file":"src/cli/args.ts","en":"Run ${APP_NAME} --help for full command and option details.\\n","zh":"运行 ${APP_NAME} --help 查看完整的命令与选项说明。\\n"},
		{"kind":"template","file":"src/cli/args.ts","en":"Run ${APP_NAME} <command> --help for command-specific help.\\n\\n","zh":"运行 ${APP_NAME} <command> --help 查看具体命令的帮助。\\n\\n"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Run Oh My Pi as an ACP (Agent Client Protocol) server over stdio","zh":"将 Oh My Pi 作为 ACP(Agent Client Protocol)服务器运行在 stdio 上"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Manage bundled task agents","zh":"管理内置任务代理"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Manage the omp auth-broker (credential vault)","zh":"管理 omp auth-broker(凭据保险库)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Run an auth-gateway forward proxy backed by the configured broker","zh":"运行由已配置 broker 支撑的 auth-gateway 转发代理"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Benchmark models with the same prompt: time-to-first-token and generation throughput (tokens/s)","zh":"用同一提示词基准测试模型:首 token 延迟与生成吞吐(tokens/s)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Run the local CDP relay that lets the browser tool drive your own Chrome tabs","zh":"运行本地 CDP 中继,让浏览器工具驱动你自己的 Chrome 标签页"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Detect and fix project diagnostics with weighted parallel subagents","zh":"用加权并行子代理检测并修复项目诊断问题"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Generate a commit message and update changelogs","zh":"生成提交信息并更新变更日志"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Print a shell completion script (bash, zsh, or fish)","zh":"输出 shell 补全脚本(bash、zsh 或 fish)"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Manage configuration settings","zh":"管理配置设置"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Dry-run OAuth account balancing across random session ids","zh":"在随机会话 ID 间试运行 OAuth 账户负载均衡"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Preview tool renderers across streaming, in-progress, success, and failure states","zh":"预览流式、进行中、成功与失败状态下的工具渲染效果"},
		{"kind":"string","file":"src/cli/command-help.ts","en":"Run storage garbage collection","zh":"运行存储垃圾回收"},
