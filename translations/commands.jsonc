		{"kind":"string","file":"src/commands/agents.ts","en":"# Overwrite existing local agent files\\n  omp agents unpack --project --force","zh":"# 覆盖已有的本地 agent 文件\\n  omp agents unpack --project --force"},
		{"kind":"string","file":"src/commands/agents.ts","en":"# Export into a custom directory\\n  omp agents unpack --dir ./tmp/agents --json","zh":"# 导出到自定义目录\\n  omp agents unpack --dir ./tmp/agents --json"},
