		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Regenerate the bearer token","zh":"重新生成 bearer token"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"SSH user@host for remote login (login --via=user@host)","zh":"远程登录使用的 SSH user@host(login --via=user@host)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Override provider id for `import` (e.g. when JSON `type` is unrecognized)","zh":"覆盖 `import` 的提供商 id(例如 JSON `type` 无法识别时)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Import credentials whose JSON has `disabled: true` (import)","zh":"导入 JSON 中 `disabled: true` 的凭据(import)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"migrate source: local SQLite + env vars (required for `migrate`)","zh":"迁移来源:本地 SQLite + 环境变量(`migrate` 必需)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Capture env-var API keys for providers not yet on broker (migrate)","zh":"捕获尚未接入 broker 的提供商的 env 环境变量 API 密钥(migrate)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Also upload OAuth from local SQLite during migrate (default skips them)","zh":"migrate 期间同时上传本地 SQLite 中的 OAuth(默认跳过)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"Print actions without executing (import / login --via / migrate)","zh":"只打印操作而不执行(import / login --via / migrate)"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Boot the broker against the local SQLite store\\n  omp auth-broker serve","zh":"# 针对本地 SQLite 存储启动 broker\\n  omp auth-broker serve"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Boot on a non-default port\\n  omp auth-broker serve --bind=127.0.0.1:9000","zh":"# 在非默认端口上启动\\n  omp auth-broker serve --bind=127.0.0.1:9000"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Print the bearer token\\n  omp auth-broker token","zh":"# 打印 bearer token\\n  omp auth-broker token"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Rotate the bearer token\\n  omp auth-broker token --regenerate","zh":"# 轮换 bearer token\\n  omp auth-broker token --regenerate"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# List supported OAuth providers\\n  omp auth-broker list","zh":"# 列出受支持的 OAuth 提供商\\n  omp auth-broker list"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Local login (run on the broker host)\\n  omp auth-broker login anthropic","zh":"# 本地登录(在 broker 主机上运行)\\n  omp auth-broker login anthropic"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Interactive provider selection\\n  omp auth-broker login","zh":"# 交互式选择提供商\\n  omp auth-broker login"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Remote login over SSH tunnel\\n  omp auth-broker login anthropic --via=user@broker","zh":"# 通过 SSH 隧道远程登录\\n  omp auth-broker login anthropic --via=user@broker"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Log out of a provider (interactive without provider arg)\\n  omp auth-broker logout anthropic","zh":"# 退出提供商登录(不带 provider 参数时交互式)\\n  omp auth-broker logout anthropic"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Import a CLIProxyAPI auth dump\\n  omp auth-broker import ~/.cliproxy/auth","zh":"# 导入 CLIProxyAPI 认证转储\\n  omp auth-broker import ~/.cliproxy/auth"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Import a single CLIProxyAPI JSON, overriding the provider mapping\\n  omp auth-broker import ~/.cliproxy/auth/claude-foo.json --provider anthropic","zh":"# 导入单个 CLIProxyAPI JSON,覆盖提供商映射\\n  omp auth-broker import ~/.cliproxy/auth/claude-foo.json --provider anthropic"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Preview a migration from local store + env vars to the configured broker\\n  omp auth-broker migrate --from-local --include-env --dry-run","zh":"# 预览从本地存储 + 环境变量到已配置 broker 的迁移\\n  omp auth-broker migrate --from-local --include-env --dry-run"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Apply the migration\\n  omp auth-broker migrate --from-local --include-env","zh":"# 执行迁移\\n  omp auth-broker migrate --from-local --include-env"},
		{"kind":"string","file":"src/commands/auth-broker.ts","en":"# Health-check the configured remote broker\\n  omp auth-broker status","zh":"# 健康检查已配置的远程 broker\\n  omp auth-broker status"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"Sub-command","zh":"子命令"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"Output JSON (token/status/check)","zh":"以 JSON 输出(token/status/check)"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"Bind address for `serve` (host:port)","zh":"`serve` 的绑定地址(host:port)"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"Regenerate the gateway bearer token (token)","zh":"重新生成 gateway bearer token(token)"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"Disable inbound bearer-token auth (serve). Useful when bound to loopback — any caller is allowed.","zh":"禁用入站 bearer-token 认证(serve)。绑定到 loopback 时很有用——允许任何调用方。"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"For `check`: additionally probe each credential against its provider's chat-completion endpoint. Slower; consumes a tiny amount of quota per credential.","zh":"用于 `check`:额外用各凭据探测其提供商的 chat-completion 端点。较慢;每条凭据会消耗少量配额。"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Boot the gateway against the configured broker\\n  omp auth-gateway serve","zh":"# 针对已配置的 broker 启动 gateway\\n  omp auth-gateway serve"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Boot on a non-default port\\n  omp auth-gateway serve --bind=127.0.0.1:4000","zh":"# 在非默认端口上启动\\n  omp auth-gateway serve --bind=127.0.0.1:4000"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Print the gateway bearer token (creates one on first run)\\n  omp auth-gateway token","zh":"# 打印 gateway bearer token(首次运行时会创建)\\n  omp auth-gateway token"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Rotate the gateway bearer token\\n  omp auth-gateway token --regenerate","zh":"# 轮换 gateway bearer token\\n  omp auth-gateway token --regenerate"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Run on loopback without any bearer (anyone on this host can call)\\n  omp auth-gateway serve --no-auth","zh":"# 在 loopback 上不带任何 bearer 运行(本机任何人都可调用)\\n  omp auth-gateway serve --no-auth"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Show local gateway + broker config status\\n  omp auth-gateway status","zh":"# 显示本地 gateway + broker 配置状态\\n  omp auth-gateway status"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Probe each broker credential to see which one is producing 401s\\n  omp auth-gateway check","zh":"# 探测各 broker 凭据,找出哪个正在产生 401\\n  omp auth-gateway check"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Same, machine-readable for scripts\\n  omp auth-gateway check --json","zh":"# 同上,输出机器可读格式供脚本使用\\n  omp auth-gateway check --json"},
		{"kind":"string","file":"src/commands/auth-gateway.ts","en":"# Strict check — also exercises each credential with a real chat-completion ping\\n  omp auth-gateway check --strict","zh":"# 严格检查——还会用真实 chat-completion ping 测试每条凭据\\n  omp auth-gateway check --strict"},
