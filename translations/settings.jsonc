		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight API URL","zh":"Hindsight API URL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight API Token","zh":"Hindsight API 令牌"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Bank ID","zh":"Hindsight 库 ID"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Recover Inline Edit Payloads","zh":"恢复行内编辑负载"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Execute edit payloads the model emits as plain text by converting them into edit tool calls","zh":"把模型以纯文本发出的编辑负载转换为 edit 工具调用执行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Record Parse Regressions","zh":"记录解析回归"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Append full before/after source when an edit introduces an AST parse failure","zh":"当编辑引入 AST 解析失败时，追加完整的修改前后源码"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-Repair Parse Regressions","zh":"自动修复解析回归"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Allow Compound Commands","zh":"允许复合命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Eval-Defined Tools","zh":"Eval 定义的工具"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fresh Workpool Agents","zh":"全新工作池代理"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Eval Auto-Background","zh":"Eval 自动转后台"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically background long-running eval cells and deliver the result later","zh":"长时间运行的 eval 单元自动转入后台，稍后交付结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the scriptable host-desktop eval prelude (screenshots, input, accessibility)","zh":"启用可脚本化的桌面 eval 前奏（截图、输入、无障碍）"},
