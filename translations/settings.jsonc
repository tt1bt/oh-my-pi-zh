		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show the recent release notes in full","zh":"完整显示最近的发布说明"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hidden","zh":"隐藏"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Do not show release notes on startup","zh":"启动时不显示发布说明"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable hidden notices for standalone ultrathink, orchestrate, and workflowz keywords","zh":"为独立的 ultrathink、orchestrate 和 workflowz 关键词启用隐藏提示"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ultrathink Keyword","zh":"Ultrathink 关键词"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Let standalone ultrathink request maximum automatic thinking and append its hidden notice","zh":"允许独立的 ultrathink 请求最大自动思考,并附加其隐藏提示"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Orchestrate Keyword","zh":"Orchestrate 关键词"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Let standalone orchestrate append its hidden multi-agent orchestration notice","zh":"允许独立的 orchestrate 附加其隐藏的多代理编排提示"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Workflow Keyword","zh":"Workflow 关键词"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Let standalone workflowz append its hidden eval workflow notice","zh":"允许独立的 workflowz 附加其隐藏的 eval workflow 提示"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Completion Notification","zh":"完成通知"},
