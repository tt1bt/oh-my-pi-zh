		{"kind":"string","file":"src/config/settings-schema.ts","en":"Very large context window","zh":"超大上下文窗口"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Save Handoff Docs","zh":"保存交接文档"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Save generated handoff documents to markdown files for the auto-handoff flow","zh":"为自动交接流程将生成的交接文档保存为 markdown 文件"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Remote Compaction V2","zh":"远程压缩 V2"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use Responses streaming compaction for compatible remote compaction models","zh":"对兼容的远程压缩模型使用 Responses 流式压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Idle Compaction","zh":"空闲压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compact context while idle when token count exceeds threshold","zh":"空闲时,当 token 数超过阈值则压缩上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Idle Compaction Threshold","zh":"空闲压缩阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Token count above which idle compaction triggers","zh":"触发空闲压缩的 token 数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Idle Compaction Delay","zh":"空闲压缩延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Seconds to wait while idle before compacting","zh":"空闲后等待多少秒再压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"30 minutes","zh":"30 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1 hour","zh":"1 小时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Supersede Stale Reads","zh":"取代过期读取"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prune older read results when the same file is read again (cache-aware, runs every turn)","zh":"再次读取同一文件时清理较旧的读取结果(缓存感知,每轮运行)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Elide Uneventful Results","zh":"省略无事件结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prune tool results flagged contextually useless (no matches, timed-out waits) once consumed (cache-aware)","zh":"消费后清理被标记为上下文无用的工具结果(无匹配、等待超时)(缓存感知)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Snapcompact System Prompt","zh":"Snapcompact 系统提示"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Experimental: render selected system prompt text as dense PNG image(s) and attach to the first user message (vision models only). Saves tokens; loses prompt caching for imaged text.","zh":"实验性:将选定的系统提示文本渲染为密集 PNG 图片,并附加到第一条用户消息(仅限视觉模型)。节省 tokens;但被成像的文本会失去 prompt 缓存。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Keep the system prompt as text.","zh":"保持系统提示为文本。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Only move loaded context-file instructions to images, when that saves tokens.","zh":"仅在节省 tokens 时,将已加载的上下文文件指令移动到图片。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"All","zh":"全部"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Move the full system prompt to images, when that saves tokens.","zh":"仅在节省 tokens 时,将完整系统提示移动到图片。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Snapcompact Tool Results","zh":"Snapcompact 工具结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Experimental: render large historical tool results as dense PNG image(s) instead of text (vision models only). Saves tokens on accumulated read/search output.","zh":"实验性:将大量历史工具结果渲染为密集 PNG 图片而不是文本(仅限视觉模型)。在累积的 read/search 输出上节省 tokens。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Tool Calling Mode","zh":"工具调用模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Controls how tools are exposed to the model. Auto uses provider-native tool calls unless the selected model is marked as not supporting them, then falls back to the GLM owned dialect. Native forces provider-native tools; the other values force the named owned dialect. Applies on session start.","zh":"控制工具如何暴露给模型。Auto 使用提供商原生工具调用,除非所选模型被标记为不支持,此时回退到 GLM 自有方言。Native 强制使用提供商原生工具;其他值强制使用指定的自有方言。在会话开始时生效。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use native tool calls unless the model is known not to support them.","zh":"除非已知模型不支持,否则使用原生工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Native","zh":"原生"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use provider-native tool calls.","zh":"使用提供商原生工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use GLM-style in-band tool calls.","zh":"使用 GLM 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use Hermes-style in-band tool calls.","zh":"使用 Hermes 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use Kimi-style in-band tool calls.","zh":"使用 Kimi 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use generic XML in-band tool calls.","zh":"使用通用 XML 带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use Anthropic-style in-band tool calls.","zh":"使用 Anthropic 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use DeepSeek-style in-band tool calls.","zh":"使用 DeepSeek 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use Harmony-style in-band tool calls.","zh":"使用 Harmony 风格带内工具调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the Qwen3 owned dialect.","zh":"使用 Qwen3 自有方言。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the Gemini owned dialect.","zh":"使用 Gemini 自有方言。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the Gemma owned dialect.","zh":"使用 Gemma 自有方言。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the MiniMax owned dialect.","zh":"使用 MiniMax 自有方言。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Snapcompact Shape","zh":"Snapcompact 形状"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Frame shape snapcompact prints text with (compaction archive and inline imaging). Auto picks a shape tuned for the current model.","zh":"snapcompact 打印文本所用的帧形状(压缩归档和内联成像)。Auto 会挑选针对当前模型调优的形状。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Picks a shape tuned for the current model, falling back to its provider family.","zh":"挑选针对当前模型调优的形状,否则回退到其提供商家族。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x8 repeated, black","zh":"8x8 重复,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"unscii square cell, black ink, every line printed twice with the copy on a pale highlight band.","zh":"unscii 方形单元,黑色墨迹,每行打印两次,副本位于浅色高亮带上。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x8 repeated, sentence hues","zh":"8x8 重复,句子色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Repeated grid with ink cycling six hues at sentence boundaries.","zh":"重复网格,墨迹在句子边界循环六种色调。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x8, black","zh":"8x8,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Plain unscii square cell, single-printed lines, black ink.","zh":"普通 unscii 方形单元,单次打印行,黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x8, sentence hues","zh":"8x8,句子色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Plain unscii square cell with sentence-hue ink.","zh":"普通 unscii 方形单元,句子色调墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"6x6 dense, black","zh":"6x6 密集,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"unscii squeezed to 6x6 — densest readable cell, fewest frames — in black ink.","zh":"unscii 压缩到 6x6——最密集的可读单元,帧数最少——黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"6x6 dense, sentence hues","zh":"6x6 密集,句子色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Densest cell with sentence-hue ink.","zh":"最密集的单元,句子色调墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5x8 legacy, black","zh":"5x8 传统,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Original X.org 5x8 glyphs on the 2576px frame, black ink.","zh":"2576px 帧上的原始 X.org 5x8 字形,黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5x8 legacy, sentence hues","zh":"5x8 传统,句子色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"The original snapcompact shape (pre-shape-table sessions rendered this).","zh":"原始 snapcompact 形状(shape 表之前的会话以此渲染)。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"6x12, dimmed stopwords","zh":"6x12,弱化虚词"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"X.org 6x12 glyphs, black ink, function words dimmed gray.","zh":"X.org 6x12 字形,黑色墨迹,功能词弱化为灰色。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13, black","zh":"8x13,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"X.org 8x13 glyphs, black ink.","zh":"X.org 8x13 字形,黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 on 16px pitch, black","zh":"8x13 / 16px 间距,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 glyphs on an 8x16 cell (extra leading), black ink.","zh":"8x16 单元上的 8x13 字形(额外行距),黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 on 22px pitch (leading), black","zh":"8x13 / 22px 行距,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 glyphs on an 8x22 cell — extra line spacing so rows don't crowd. Default for OpenAI/Google.","zh":"8x22 单元上的 8x13 字形——额外的行间距,避免行拥挤。OpenAI/Google 的默认值。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 on 11px advance (tracking), black","zh":"8x13 / 11px 字距,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8x13 glyphs on an 11x16 cell — extra letter spacing so characters don't merge. Default for Anthropic.","zh":"11x16 单元上的 8x13 字形——额外的字间距,避免字符粘连。Anthropic 的默认值。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Silver 16, CJK","zh":"Silver 16,CJK"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Embedded Silver TrueType font on a 16px grid for CJK and other non-Latin text.","zh":"16px 网格上的内嵌 Silver TrueType 字体,用于 CJK 和其他非拉丁文本。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Doc 8on16, black","zh":"文档 8on16,黑色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Two word-wrapped newspaper columns of 8x13 glyphs on a 16px pitch, black ink.","zh":"16px 间距上的两栏自动换行报纸式 8x13 字形,黑色墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Doc 8on16, sentence hues","zh":"文档 8on16,句子色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Two-column doc layout with sentence-hue ink.","zh":"双栏文档布局,句子色调墨迹。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Doc 8on16, sentence hues + dimmed stopwords","zh":"文档 8on16,句子色 + 弱化虚词"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Two-column doc layout, sentence-hue ink, function words dimmed gray.","zh":"双栏文档布局,句子色调墨迹,功能词弱化为灰色。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Branch Summaries","zh":"分支摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prompt to summarize when leaving a branch","zh":"离开分支时提示生成摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Memory Backend","zh":"记忆后端"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"No memory subsystem runs","zh":"不运行任何记忆子系统"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local","zh":"本地"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local rollout summarisation pipeline (memory_summary.md)","zh":"本地 rollout 总结流水线 (memory_summary.md)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Vectorize Hindsight remote memory service","zh":"Vectorize Hindsight 远程记忆服务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local SQLite recall/retain backend with optional embeddings","zh":"本地 SQLite 回忆/保留后端,可选 embeddings"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-Learn (experimental)","zh":"自动学习(实验性)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"After the agent stops, nudge it to capture lessons to memory and create/enhance isolated managed skills","zh":"代理停止后,提示它将经验教训存入记忆,并创建/增强隔离的托管技能"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-run capture at stop","zh":"停止时自动运行捕获"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"When on, auto-run one private capture turn at stop (uses extra tokens). When off, only standing auto-learn guidance remains.","zh":"开启时,在停止时自动运行一次私有捕获轮(消耗额外 tokens)。关闭时,仅保留常驻的自动学习指导。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi DB Path","zh":"Mnemopi DB 路径"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional SQLite DB path. Defaults to the agent memories directory.","zh":"可选的 SQLite DB 路径。默认为代理记忆目录。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional shared bank base name. Per-project modes derive project-local banks from it.","zh":"可选共享 bank 基名。按项目模式从中派生项目本地 bank。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Scoping","zh":"Mnemopi 作用域"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"global = one shared bank; per-project = isolated bank per cwd; per-project-tagged = project-local writes plus global recall visibility","zh":"global = 一个共享 bank;per-project = 每个 cwd 一个隔离 bank;per-project-tagged = 项目本地写入,同时全局可见可回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"One shared Mnemopi bank for every project","zh":"所有项目共用一个 Mnemopi bank"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Per project","zh":"按项目"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Project-local Mnemopi bank per cwd basename","zh":"每个 cwd 基名一个项目本地 Mnemopi bank"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Per project (tagged)","zh":"按项目(带标签)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Write to a project-local bank but merge project + shared recall results","zh":"写入项目本地 bank,但合并项目 + 共享的回忆结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Embedding variant","zh":"Embedding 变体"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local embedding model family. en = stronger English model; multilingual = cross-language model. Changing this rebuilds existing memory embeddings on next start.","zh":"本地 embedding 模型系列。en = 更强的英语模型;multilingual = 跨语言模型。更改后会在下次启动时重建现有记忆 embeddings。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"English (bge-base-en-v1.5)","zh":"英语 (bge-base-en-v1.5)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"BAAI/bge-base-en-v1.5 (768d), English-only","zh":"BAAI/bge-base-en-v1.5 (768d),仅英语"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Multilingual (multilingual-e5-large)","zh":"多语言 (multilingual-e5-large)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"intfloat/multilingual-e5-large (1024d), cross-language recall","zh":"intfloat/multilingual-e5-large (1024d),跨语言回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Auto Recall","zh":"Mnemopi 自动回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Recall local memories into the first turn of each session","zh":"在每个会话的第一轮回忆本地记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Auto Retain","zh":"Mnemopi 自动保留"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Retain completed conversation turns into local Mnemopi memory","zh":"将已完成的对话轮次保留到本地 Mnemopi 记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Polyphonic Recall","zh":"Mnemopi 多声部回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable 4-voice recall (vector, graph, fact, temporal) fused with reciprocal rank fusion","zh":"启用 4 声部回忆(向量、图、事实、时间),并用倒数排名融合合并"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Enhanced Recall","zh":"Mnemopi 增强回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the tiered query result cache for repeated and similar recall queries","zh":"为重复和相似的回忆查询启用分层查询结果缓存"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Proactive Linking","zh":"Mnemopi 主动链接"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ingest new memories into the episodic graph as they are stored, linking them to related entities and memories","zh":"新记忆在存储时摄取到情节图中,链接到相关实体和记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Disable Embeddings","zh":"Mnemopi 禁用 Embeddings"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Force deterministic FTS-only recall instead of vector embeddings","zh":"强制使用确定性的纯 FTS 回忆,而不是向量 embeddings"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi Embedding Model","zh":"Mnemopi Embedding 模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Advanced: explicit embedding model id that overrides the variant. Leave empty to use mnemopi.embeddingVariant.","zh":"高级:覆盖变体的显式 embedding 模型 id。留空则使用 mnemopi.embeddingVariant。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional OpenAI-compatible embedding endpoint passed to Mnemopi","zh":"传递给 Mnemopi 的可选 OpenAI 兼容 embedding 端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional embedding API key passed to Mnemopi","zh":"传递给 Mnemopi 的可选 embedding API key"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi LLM Mode","zh":"Mnemopi LLM 模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use no LLM, the online tiny model (the TINY role from /models, else @smol), or a remote OpenAI-compatible endpoint","zh":"不使用 LLM、使用在线小模型(来自 /models 的 TINY 角色,否则为 @smol),或使用远程 OpenAI 兼容端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disable Mnemopi LLM-backed extraction","zh":"禁用 Mnemopi 基于 LLM 的提取"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Online (tiny)","zh":"在线 (tiny)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the online tiny model (the TINY role from /models, else @smol)","zh":"使用在线小模型(来自 /models 的 TINY 角色,否则为 @smol)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Remote","zh":"远程"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the Mnemopi remote LLM settings below","zh":"使用下面的 Mnemopi 远程 LLM 设置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional OpenAI-compatible LLM endpoint for Mnemopi remote mode","zh":"Mnemopi 远程模式的可选 OpenAI 兼容 LLM 端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional LLM API key for Mnemopi remote mode","zh":"Mnemopi 远程模式的可选 LLM API key"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi LLM Model","zh":"Mnemopi LLM 模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional LLM model name for Mnemopi remote mode","zh":"Mnemopi 远程模式的可选 LLM 模型名"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight server URL (Cloud or self-hosted)","zh":"Hindsight 服务器 URL(云或自托管)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Bearer token for authenticated Hindsight servers","zh":"用于需要认证的 Hindsight 服务器的 Bearer token"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Memory bank identifier (default: project name)","zh":"记忆 bank 标识(默认:项目名)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Scoping","zh":"Hindsight 作用域"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"global = one shared bank; per-project = isolated bank per cwd; per-project-tagged = shared bank with project tags so global + project memories merge on recall","zh":"global = 一个共享 bank;per-project = 每个 cwd 一个隔离 bank;per-project-tagged = 带项目标签的共享 bank,使全局 + 项目记忆在回忆时合并"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"One shared bank — every project sees the same memories","zh":"一个共享 bank——所有项目看到相同的记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Isolated bank per cwd basename — projects cannot see each other's memories","zh":"每个 cwd 基名一个隔离 bank——项目之间看不到彼此的记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Shared bank, retains tagged with project:<cwd>. Recall surfaces project + untagged global memories together","zh":"共享 bank,记忆以 project:<cwd> 标记。回忆时项目 + 未标记的全局记忆一起浮现"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Auto Recall","zh":"Hindsight 自动回忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Recall memories on the first turn of each session","zh":"在每个会话的第一轮回忆记忆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Auto Retain","zh":"Hindsight 自动保留"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Retain transcript every N turns and at session boundaries","zh":"每 N 轮及会话边界保留记录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Retain Mode","zh":"Hindsight 保留模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"full-session = upsert one document per session, last-turn = chunked","zh":"full-session = 每个会话 upsert 一个文档,last-turn = 分块"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Full session","zh":"完整会话"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Upsert one document per session (recommended)","zh":"每个会话 upsert 一个文档(推荐)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Last turn","zh":"最后一轮"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Chunked retention sliced by turn boundaries","zh":"按轮次边界切分的分块保留"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Mental Models","zh":"Hindsight 心智模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read curated reflect summaries (mental models) into developer instructions at boot. Loads existing models on the bank — does not write. Pair with hindsight.mentalModelAutoSeed to also auto-create the built-in seed set.","zh":"启动时将精选的 reflect 摘要(心智模型)读入开发者指令。加载 bank 上已有的模型——不写入。配合 hindsight.mentalModelAutoSeed 可同时自动创建内置种子集。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hindsight Mental Model Auto-Seed","zh":"Hindsight 心智模型自动播种"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"At session start, create any built-in mental models (project-conventions, project-decisions, user-preferences) that do not yet exist on the bank.","zh":"会话开始时,创建 bank 上尚不存在的内置心智模型(project-conventions、project-decisions、user-preferences)。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Interrupt the agent mid-stream when output matches rule patterns (Time-Traveling Stream Rules)","zh":"当输出匹配规则模式时在流中中断代理(Time-Traveling Stream Rules)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"TTSR Context Mode","zh":"TTSR 上下文模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"What to do with partial output when TTSR triggers","zh":"TTSR 触发时如何处理部分输出"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"TTSR Interrupt Mode","zh":"TTSR 中断模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"When to interrupt mid-stream vs inject warning after completion","zh":"何时在流中中断,与完成后注入警告"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"always","zh":"总是"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Interrupt on prose and tool streams","zh":"在正文和工具流上中断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"prose-only","zh":"仅正文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Interrupt only on reply/thinking matches","zh":"仅在回复/思考匹配时中断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"tool-only","zh":"仅工具"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Interrupt only on tool-call argument matches","zh":"仅在工具调用参数匹配时中断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"never","zh":"从不"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Never interrupt; inject warning after completion","zh":"从不中断;完成后注入警告"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"TTSR Repeat Mode","zh":"TTSR 重复模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How rules can repeat: once per session or after a message gap","zh":"规则如何重复:每个会话一次,或在消息间隔后"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"TTSR Repeat Gap","zh":"TTSR 重复间隔"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Messages before a rule can trigger again","zh":"规则再次触发前需要经过的消息数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5 messages","zh":"5 条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"10 messages","zh":"10 条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"15 messages","zh":"15 条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"20 messages","zh":"20 条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"30 messages","zh":"30 条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Built-in Rules","zh":"内置规则"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load the default rules shipped with the agent (override individually with ttsr.disabledRules)","zh":"加载代理自带默认规则(可通过 ttsr.disabledRules 单独覆盖)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disabled Rules","zh":"禁用的规则"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Rule names to ignore entirely (applies to bundled defaults and your own rules)","zh":"完全忽略的规则名(适用于内置默认规则和你自己的规则)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Edit Mode","zh":"编辑模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Select the edit tool variant (replace, patch, hashline, or apply_patch)","zh":"选择编辑工具变体(replace、patch、hashline 或 apply_patch)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fuzzy Match","zh":"模糊匹配"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Accept high-confidence fuzzy matches for whitespace differences","zh":"接受高置信度的空白差异模糊匹配"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fuzzy Match Threshold","zh":"模糊匹配阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Similarity threshold (0-1) for accepting fuzzy matches","zh":"接受模糊匹配的相似度阈值 (0-1)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Lenient","zh":"宽松"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Moderate","zh":"适中"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Abort on Failed Preview","zh":"预览失败时中止"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Abort streaming edit tool calls when patch preview fails","zh":"补丁预览失败时中止流式编辑工具调用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Block Auto-Generated Files","zh":"阻止自动生成的文件"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prevent editing of files that appear to be auto-generated (protoc, sqlc, swagger, etc.)","zh":"防止编辑看起来是自动生成的文件(protoc、sqlc、swagger 等)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enforce Seen-Line Guard","zh":"强制已见行保护"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Reject edits anchored on lines a prior read/search never displayed in full","zh":"拒绝锚定在先前 read/search 从未完整显示的行上的编辑"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Line Numbers","zh":"行号"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prepend line numbers to read tool output by default","zh":"默认在 read 工具输出前加上行号"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default Read Limit","zh":"默认读取行数上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default number of lines returned when agent calls read without a limit","zh":"代理不带限制调用 read 时返回的默认行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"200 lines","zh":"200 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"300 lines","zh":"300 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Markdown Previews","zh":"Markdown 预览"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Render Markdown read results as formatted terminal Markdown previews instead of raw source","zh":"将 Markdown 读取结果渲染为格式化终端 Markdown 预览,而不是原始源码"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Return structural code summaries when read is called without an explicit selector","zh":"当 read 未带显式选择器调用时,返回结构化代码摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prose Summaries","zh":"正文摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Return structural summaries for Markdown and plain text reads","zh":"为 Markdown 和纯文本读取返回结构化摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read Summary Body Lines","zh":"读取摘要正文行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Minimum multiline body or literal length before read summaries collapse it","zh":"read 摘要折叠多行正文或字面量之前的最小长度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read Summary Comment Lines","zh":"读取摘要注释行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Minimum multiline block comment length before read summaries collapse it","zh":"read 摘要折叠多行块注释之前的最小长度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read Summary Minimum File Length","zh":"读取摘要最小文件长度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Files with fewer total lines are read verbatim instead of structurally summarized","zh":"总行数更少的文件按原样读取,而不是结构化摘要"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read Summary Unfold Target","zh":"读取摘要展开目标"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"BFS-unfold elidable spans until the summary is at least this many visible lines. 0 keeps only the outermost elisions.","zh":"BFS 展开可省略片段,直到摘要至少达到这么多可见行。0 仅保留最外层的省略。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read Summary Unfold Ceiling","zh":"读取摘要展开上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hard ceiling on summary size while BFS-unfolding. An unfold whose revealed lines would exceed this is skipped (that span stays folded) and unfolding continues with the remaining spans.","zh":"BFS 展开时摘要大小的硬上限。展开后超过此值的片段会被跳过(该片段保持折叠),继续展开其余片段。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Inline Read Previews","zh":"内联读取预览"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Render read tool results inline in the transcript instead of summary rows","zh":"在记录中内联渲染 read 工具结果,而不是摘要行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the lsp tool for code intelligence (definitions, references, diagnostics, rename)","zh":"启用 lsp 工具以获得代码智能(定义、引用、诊断、重命名)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Lazy LSP Startup","zh":"LSP 懒启动"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Start language servers on first use (lsp tool or editing a matching file type) instead of at session startup","zh":"在首次使用时启动语言服务器(lsp 工具或编辑匹配的文件类型),而不是在会话启动时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Shared Language Servers","zh":"共享语言服务器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Share one language server per project across omp instances via the daemon broker (falls back to private servers when unavailable)","zh":"通过守护进程 broker 在多个 omp 实例之间共享每个项目一个语言服务器(不可用时回退到私有服务器)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Format on Write","zh":"写入时格式化"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically format code files using LSP after writing","zh":"写入后使用 LSP 自动格式化代码文件"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Diagnostics on Write","zh":"写入时诊断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Return LSP diagnostics after writing code files","zh":"写入代码文件后返回 LSP 诊断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Diagnostics on Edit","zh":"编辑时诊断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Return LSP diagnostics after editing code files","zh":"编辑代码文件后返回 LSP 诊断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Deduplicate Diagnostics","zh":"诊断去重"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Suppress post-edit LSP diagnostics already shown for a file; only surface new or changed ones","zh":"抑制文件中已显示过的编辑后 LSP 诊断;只显示新增或变化的诊断"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the bash tool for shell command execution","zh":"启用 bash 工具执行 shell 命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Bash Auto-Background","zh":"Bash 自动后台化"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically background long-running bash commands and deliver the result later","zh":"自动将长时间运行的 bash 命令后台化,稍后交付结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Bash Approval Patterns","zh":"Bash 审批模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ordered bash command approval rules. Each item has match and approval fields; only '*' wildcards are supported.","zh":"有序的 bash 命令审批规则。每项包含 match 和 approval 字段;仅支持 '*' 通配符。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Bash Interceptor","zh":"Bash 拦截器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Block shell commands that have dedicated tools","zh":"阻止已有专用工具的 shell 命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"direnv Auto-Load","zh":"direnv 自动加载"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-load a repo's direnv/devenv `.envrc` into the bash session so devenv tools and env vars are present without manual `direnv exec`. Honors direnv's allow list: an `.envrc` you haven't `direnv allow`ed is never executed","zh":"自动将仓库的 direnv/devenv `.envrc` 加载到 bash 会话,使 devenv 工具和环境变量无需手动 `direnv exec` 即可使用。遵循 direnv 的允许列表:未经 `direnv allow` 的 `.envrc` 永远不会被执行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"direnv Load Timeout (ms)","zh":"direnv 加载超时 (ms)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max wait for the first `direnv export` (a cold devenv shell can be slow); on timeout the session runs without the direnv env","zh":"等待第一次 `direnv export` 的最大时间(冷 devenv shell 可能很慢);超时后会话在没有 direnv 环境的情况下运行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Shell Minimizer","zh":"Shell 输出压缩器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compress verbose shell output (git, npm, cargo, etc.) before returning it to the agent","zh":"在将冗长的 shell 输出(git、npm、cargo 等)返回给代理之前进行压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Shell Minimizer Source Outline","zh":"Shell 压缩器源码大纲"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Source outline mode for cat/read of source files: default or aggressive","zh":"cat/read 源码文件的源码大纲模式:default 或 aggressive"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Python Eval Backend","zh":"Python Eval 后端"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Allow the eval tool to dispatch Python cells to the IPython kernel","zh":"允许 eval 工具将 Python 单元派发给 IPython 内核"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"JavaScript Eval Backend","zh":"JavaScript Eval 后端"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Allow the eval tool to dispatch JavaScript cells to the in-process runtime","zh":"允许 eval 工具将 JavaScript 单元派发给进程内运行时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Python Kernel Mode","zh":"Python 内核模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Keep the IPython kernel alive across eval calls or start fresh each time","zh":"在多次 eval 调用之间保持 IPython 内核存活,或每次都重新启动"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Python Interpreter","zh":"Python 解释器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Optional path to an exact Python executable. When set, automatic Python runtime discovery is skipped.","zh":"指定 Python 可执行文件的可选路径。设置后将跳过自动 Python 运行时发现。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Tool Approval Policies","zh":"工具审批策略"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Per-tool approval policies. Set to 'allow' to auto-approve, 'prompt' to require confirmation, or 'deny' to block. Overrides are honored in every approval mode.","zh":"按工具设置的审批策略。设为 'allow' 自动批准,'prompt' 要求确认,或 'deny' 阻止。覆盖在每种审批模式下都生效。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Tool Approval","zh":"工具审批"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default approval behavior for tool calls. 'Always ask' auto-approves read-only tools only. 'Write' auto-approves read and workspace-write tools. 'Yolo' auto-approves all tiers; user policy may still prompt or block.","zh":"工具调用的默认审批行为。'Always ask' 仅自动批准只读工具。'Write' 自动批准读取和工作区写入工具。'Yolo' 自动批准所有层级;用户策略仍可提示或阻止。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Always ask","zh":"总是询问"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-approve read-only tools; require confirmation for write and exec tools.","zh":"自动批准只读工具;写入和执行工具需要确认。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Write","zh":"写入"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-approve read-only and write tools; require confirmation for exec tools such as bash, eval, browser, and task.","zh":"自动批准只读和写入工具;bash、eval、browser、task 等执行工具需要确认。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-approve read, write, and exec tools. User policy can still require confirmation or block calls.","zh":"自动批准读取、写入和执行工具。用户策略仍可要求确认或阻止调用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the todo tool for task tracking","zh":"启用 todo 工具进行任务跟踪"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Todo Reminders","zh":"待办提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Remind the agent to complete todos before stopping","zh":"提醒代理在停止前完成待办"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Todo Reminder Limit","zh":"待办提醒上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum number of todo reminders before giving up","zh":"放弃前的最多待办提醒次数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1 reminder","zh":"1 次提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"2 reminders","zh":"2 次提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"3 reminders","zh":"3 次提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5 reminders","zh":"5 次提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Create Todos Automatically","zh":"自动创建待办"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How strongly to push automatic todo-list creation after the first message","zh":"第一条消息后自动创建待办列表的推动力度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Model decides; no automatic todo list","zh":"由模型决定;不自动创建待办列表"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Preferred","zh":"偏好"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Suggests a todo list on the first message (reminder, not forced)","zh":"在第一条消息时建议待办列表(提醒,而非强制)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Always","zh":"总是"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Forces a comprehensive todo list on the first message","zh":"在第一条消息时强制创建完整待办列表"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the glob tool for glob-based file lookup","zh":"启用 glob 工具进行基于 glob 的文件查找"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the grep tool for regex content search","zh":"启用 grep 工具进行正则内容搜索"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Grep Context Before","zh":"Grep 前上下文行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Lines of context before each grep match","zh":"每个 grep 匹配之前的上下文行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"0 lines","zh":"0 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1 line","zh":"1 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"2 lines","zh":"2 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"3 lines","zh":"3 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5 lines","zh":"5 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Grep Context After","zh":"Grep 后上下文行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Lines of context after each grep match","zh":"每个 grep 匹配之后的上下文行数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"10 lines","zh":"10 行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the ast_grep tool for structural AST search","zh":"启用 ast_grep 工具进行结构化 AST 搜索"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the ast_edit tool for structural AST rewrites","zh":"启用 ast_edit 工具进行结构化 AST 重写"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the debug tool for DAP-based debugging","zh":"启用 debug 工具进行基于 DAP 的调试"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the launch tool for supervising shared long-running project processes","zh":"启用 launch 工具监管共享的长期运行项目进程"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech Generation","zh":"语音生成"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the tts tool for on-device (Kokoro) or xAI Grok Voice speech-file synthesis","zh":"启用 tts 工具进行设备端 (Kokoro) 或 xAI Grok Voice 语音文件合成"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Generate Image","zh":"生成图片"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the generate_image tool (text-to-image generation and editing). Exposed as an xd:// device when tools.xdev is on.","zh":"启用 generate_image 工具(文生图生成和编辑)。当 tools.xdev 开启时作为 xd:// 设备暴露。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Computer Display","zh":"计算机显示器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Composite all displays or select a native display id","zh":"合并所有显示器,或选择原生显示器 id"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Computer Screenshot Width","zh":"计算机截图宽度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum composite screenshot width in pixels","zh":"合并截图的最大宽度(像素)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Computer Screenshot Height","zh":"计算机截图高度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum composite screenshot height in pixels","zh":"合并截图的最大高度(像素)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"3 minutes","zh":"3 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Checkpoint/Rewind","zh":"检查点/回退"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the checkpoint and rewind tools for context checkpointing","zh":"启用 checkpoint 和 rewind 工具进行上下文检查点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Read URLs","zh":"读取 URL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Allow the read tool to fetch and process URLs","zh":"允许 read 工具抓取和处理 URL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the vault:// internal URL for reading and editing Obsidian vault content via the Obsidian CLI. When disabled, vault:// resolution is refused and the vault:// entry is omitted from the system prompt.","zh":"启用 vault:// 内部 URL,通过 Obsidian CLI 读取和编辑 Obsidian vault 内容。禁用后,vault:// 解析被拒绝,并且系统提示中省略 vault:// 条目。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the github tool (op-based dispatch for repository, issue, pull request, diff, search, checkout, push, and Actions watch workflows)","zh":"启用 github 工具(基于 op 的派发,用于仓库、issue、pull request、diff、搜索、checkout、push 和 Actions watch 工作流)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"GitHub View Cache","zh":"GitHub 视图缓存"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Cache rendered issue/PR view output in ~/.omp/cache/github-cache.db so repeated reads are free","zh":"将渲染后的 issue/PR 视图输出缓存在 ~/.omp/cache/github-cache.db,使重复读取免费"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"GitHub Cache Soft TTL","zh":"GitHub 缓存软 TTL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Within this window, cached issue/PR view rows are returned directly (seconds; default 5 minutes)","zh":"在此窗口内,直接返回缓存的 issue/PR 视图行(秒;默认 5 分钟)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"GitHub Cache Hard TTL","zh":"GitHub 缓存硬 TTL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Past the soft TTL the cached row is returned and refreshed in the background; past the hard TTL it is dropped (seconds; default 7 days)","zh":"超过软 TTL 后,返回缓存行并在后台刷新;超过硬 TTL 后丢弃(秒;默认 7 天)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Web Search","zh":"Web 搜索"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the web_search tool for live web results","zh":"启用 web_search 工具获取实时网页结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Security","zh":"安全"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable OMP-native security scan planning, execution, and the read-only security:// resource namespace","zh":"启用 OMP 原生安全扫描规划、执行,以及只读的 security:// 资源命名空间"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ask","zh":"询问"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable the ask tool for interactive user questions","zh":"启用 ask 工具进行交互式用户提问"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default HTTP CDP discovery endpoint (for example http://127.0.0.1:9222) to attach to instead of launching a browser. Explicit app.cdp_url or app.path on the tool call take precedence.","zh":"默认的 HTTP CDP 发现端点(例如 http://127.0.0.1:9222),用于附加到现有浏览器而不是启动新浏览器。工具调用上的显式 app.cdp_url 或 app.path 优先。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"omp browser relay endpoint (default http://127.0.0.1:9224).","zh":"omp browser relay 端点(默认 http://127.0.0.1:9224)。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Headless Browser","zh":"无头浏览器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Launch browser in headless mode (disable to show browser UI)","zh":"以无头模式启动浏览器(禁用则显示浏览器 UI)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"cmux Browser","zh":"cmux 浏览器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use cmux WKWebView surfaces for browser automation when a cmux socket is available. Set PI_BROWSER_CMUX=0 or PI_BROWSER_CMUX=1 to override.","zh":"当 cmux socket 可用时,使用 cmux WKWebView 表面进行浏览器自动化。设置 PI_BROWSER_CMUX=0 或 PI_BROWSER_CMUX=1 可覆盖。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Screenshot Directory","zh":"截图目录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Directory to save screenshots. If unset, screenshots go to a temp file. Supports ~. Examples: ~/Downloads, ~/Desktop, /sdcard/Download (Android)","zh":"保存截图的目录。未设置时,截图保存到临时文件。支持 ~。例如:~/Downloads、~/Desktop、/sdcard/Download (Android)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Intent Tracing","zh":"意图跟踪"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ask the agent to describe the intent of each tool call before executing it","zh":"要求代理在执行每个工具调用前描述其意图"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Abort On Fabricated Tool Result","zh":"伪造工具结果时中止"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"With in-band tool calls, stop the model immediately when it starts hallucinating a tool result mid-turn. Disable to let the model finish generating and discard the fabricated continuation instead.","zh":"使用带内工具调用时,当模型在一轮中途开始幻觉工具结果时立即停止。禁用则让模型完成生成,然后丢弃伪造的延续内容。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max Tool Timeout","zh":"最大工具超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum timeout in seconds the agent can set for any tool (0 = no limit)","zh":"代理可为任何工具设置的最大超时(秒)(0 = 无限制)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"No limit","zh":"无限制"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Async Execution","zh":"异步执行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable async bash commands and background task execution","zh":"启用异步 bash 命令和后台任务执行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max Poll Time","zh":"最大轮询时间"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How long a `hub` wait watches background jobs before returning the current state. A fixed value waits that exact duration every time. `smart` adapts: it starts at 5s and lengthens with each back-to-back wait (up to 5m), then resets to 5s after about a minute without waiting.","zh":"`hub` wait 在返回当前状态前观察后台任务的时间。固定值每次都等待相同时长。`smart` 自适应:从 5s 开始,每次连续等待后延长(最长 5m),大约一分钟没有等待后重置为 5s。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5 seconds","zh":"5 秒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"10 seconds","zh":"10 秒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Smart","zh":"智能"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default — adaptive 5s→5m, resets when you stop polling","zh":"默认——自适应 5s→5m,停止轮询时重置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"IRC Timeout","zh":"IRC 超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default timeout for hub message waits (and send await:true) in milliseconds; 0 disables the timeout","zh":"hub 消息等待(以及 send await:true)的默认超时(毫秒);0 禁用超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"xd:// Tools","zh":"xd:// 工具"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"xd:// Prompt Docs","zh":"xd:// 提示文档"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Choose which mounted-device docs and schemas are inlined in the system prompt. Built-ins keeps core tools inline while MCP and extension tools stay on-demand.","zh":"选择哪些已挂载设备的文档和 schema 内联到系统提示中。Built-ins 将核心工具保持内联,而 MCP 和扩展工具保持按需加载。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"All Devices","zh":"所有设备"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Inline docs and schemas for every mounted device.","zh":"为每个已挂载设备内联文档和 schema。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Built-ins Only","zh":"仅内置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Inline built-in docs; fetch MCP and extension docs on demand.","zh":"内联内置文档;按需获取 MCP 和扩展文档。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Catalog Only","zh":"仅目录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"List every device; fetch all docs on demand.","zh":"列出所有设备;按需获取所有文档。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"xd:// Inline Devices","zh":"xd:// 内联设备"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"When xd:// Prompt Docs is Built-ins Only, inline dynamic devices whose names match these glob patterns (for example mcp__context_mode_*). Catalog Only ignores this setting.","zh":"当 xd:// 提示文档为仅内置时,内联名称匹配这些 glob 模式的动态设备(例如 mcp__context_mode_*)。仅目录模式忽略此设置。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"MCP Project Config","zh":"MCP 项目配置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load .mcp.json/mcp.json from project root","zh":"从项目根目录加载 .mcp.json/mcp.json"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"MCP Markdown Results","zh":"MCP Markdown 结果"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Render non-JSON MCP text results as Markdown in the transcript","zh":"在记录中将非 JSON 的 MCP 文本结果渲染为 Markdown"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"MCP Update Injection","zh":"MCP 更新注入"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Inject MCP resource updates into the agent conversation","zh":"将 MCP 资源更新注入代理对话"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"MCP Notification Debounce","zh":"MCP 通知防抖"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Debounce window in milliseconds for MCP resource updates before injecting them into the conversation","zh":"MCP 资源更新在注入对话前的防抖窗口(毫秒)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Plan Mode","zh":"计划模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable plan mode for read-only exploration and planning before execution","zh":"启用计划模式,在执行前进行只读探索和规划"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Start in Plan Mode","zh":"以计划模式启动"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically enter plan mode at the start of every new session","zh":"每个新会话开始时自动进入计划模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Goal Mode","zh":"目标模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable per-session goal mode and the hidden goal tool","zh":"启用按会话的目标模式和隐藏的 goal 工具"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Goal Status in Footer","zh":"页脚显示目标状态"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show token budget alongside the goal indicator in the status line","zh":"在状态栏的目标指示器旁显示 token 预算"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Goal Continuation Modes","zh":"目标延续模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Run modes where active goals may auto-continue between turns","zh":"活跃目标可在轮次之间自动延续的运行模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Refresh Title on Replan","zh":"重新规划时刷新标题"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Refresh generated session titles after todo init replans unless the title was set by the user","zh":"在 todo init 重新规划后刷新生成的会话标题,除非标题由用户设置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Let the PAL pick the best available backend","zh":"让 PAL 选择最佳可用后端"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"btrfs subvolume snapshot","zh":"btrfs 子卷快照"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"ZFS snapshot + clone","zh":"ZFS 快照 + 克隆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Linux FICLONE per-file reflink","zh":"Linux FICLONE 按文件 reflink"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Linux kernel overlay (or fuse-overlayfs fallback)","zh":"Linux 内核 overlay(或 fuse-overlayfs 回退)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Block clone","zh":"块克隆"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Recursive copy","zh":"递归复制"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"git worktree if available, otherwise recursive copy","zh":"可用时用 git worktree,否则递归复制"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Apply Isolated Changes","zh":"应用隔离更改"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically apply successful isolated task changes to the parent checkout; disable to retain patch or branch artifacts","zh":"自动将成功的隔离任务更改应用到父 checkout;禁用则保留 patch 或 branch 产物"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Isolation Merge Strategy","zh":"隔离合并策略"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How isolated task changes are integrated (patch apply or branch merge)","zh":"隔离任务更改如何整合(patch 应用或 branch 合并)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Patch","zh":"补丁"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Combine diffs and git apply","zh":"合并 diffs 并 git apply"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Branch","zh":"分支"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Commit per task, merge with --no-ff","zh":"每个任务一个提交,以 --no-ff 合并"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Isolation Commit Style","zh":"隔离提交风格"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Commit message style for nested repo changes (generic or AI-generated)","zh":"嵌套仓库更改的提交消息风格(generic 或 AI 生成)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Generic","zh":"通用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Static commit message","zh":"静态提交消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"AI-generated commit message from diff","zh":"根据 diff 由 AI 生成的提交消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Worktree Base Directory","zh":"Worktree 基础目录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Base directory for agent-managed worktrees — task-isolation copies, `github` PR checkouts, and `omp worktree` cleanup all live here. Unset uses ~/.omp/wt. Must be an absolute or ~-relative path; relative paths are ignored. The OMP_WORKTREE_DIR env var overrides this.","zh":"代理管理工作树的基目录——task 隔离副本、`github` PR checkout 和 `omp worktree` 清理都在这里。未设置时使用 ~/.omp/wt。必须是绝对路径或以 ~ 开头的路径;相对路径被忽略。OMP_WORKTREE_DIR 环境变量可覆盖此项。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prefer Task Delegation","zh":"偏好任务委派"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How strongly to push delegating work to subagents","zh":"推动将工作委派给子代理的力度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Adds delegation guidance to the system prompt","zh":"向系统提示添加委派指导"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prompt guidance plus a first-turn delegation reminder","zh":"提示指导外加第一轮委派提醒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Batch Task Calls","zh":"批量任务调用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Switch the task tool to its batch shape: one call carries { context, tasks[] } — one subagent per item, with an optional per-item agent (defaulting to the session spawn-policy agent), per-item isolation, and a required shared context prepended to every assignment. With async.enabled=true, each spawn runs as an independent background agent with the normal idle/parked lifecycle; otherwise the call blocks for merged results. Disable to restore the flat single-spawn schema.","zh":"将 task 工具切换为批量形态:一次调用携带 { context, tasks[] }——每个条目一个子代理,可选的逐条目 agent(默认为会话派生策略 agent)、逐条目隔离,以及预置到每个任务前的必需共享 context。当 async.enabled=true 时,每次派生作为独立的后台代理运行,遵循常规的 idle/parked 生命周期;否则调用会阻塞以等待合并结果。禁用则恢复扁平的单个派生 schema。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Per-Task Effort","zh":"按任务思考力度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Expose the optional effort parameter on task spawns, allowing callers to override each subagent's thinking level","zh":"在 task 派生时暴露可选的 effort 参数,允许调用方覆盖每个子代理的思考级别"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max Concurrent Tasks","zh":"最大并发任务数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum number of subagents running concurrently","zh":"并发运行的子代理最大数量"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Unlimited","zh":"无限制"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1 task","zh":"1 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"2 tasks","zh":"2 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"4 tasks","zh":"4 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"8 tasks","zh":"8 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"16 tasks","zh":"16 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"32 tasks","zh":"32 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"64 tasks","zh":"64 个任务"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"LSP in Subagents","zh":"子代理中的 LSP"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Allow subagents spawned via the task tool to use the lsp tool. Off by default to keep subagents cheap; enable when LSP-aware delegation is worth the extra tokens.","zh":"允许通过 task 工具派生的子代理使用 lsp 工具。默认关闭以保持子代理成本低廉;当 LSP 感知的委派值得额外 tokens 时启用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max Task Recursion","zh":"最大任务递归深度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How many levels deep subagents can spawn their own subagents","zh":"子代理可以派生自己的子代理的嵌套深度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Single","zh":"一层"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Double","zh":"两层"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Triple","zh":"三层"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Max Subagent Runtime","zh":"最大子代理运行时间"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hard wall-clock limit per subagent (ms). 0 disables it. Defense-in-depth against provider-side stream hangs that escape the inference-layer watchdog; triggers a normal subagent abort with a 'timed out' reason.","zh":"每个子代理的硬墙钟限制(毫秒)。0 禁用。针对逃脱推理层看门狗的提供商侧流挂起提供纵深防御;触发带有 'timed out' 原因的正常子代理中止。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"15 minutes","zh":"15 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Agent Idle TTL","zh":"代理空闲 TTL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How long an idle subagent stays live in memory before being parked to disk (ms). Parked agents are revived automatically when messaged or resumed. 0 keeps idle agents live until exit.","zh":"空闲子代理在被停驻到磁盘前保持内存存活的时间(毫秒)。停驻的代理在收到消息或恢复时自动唤醒。0 让空闲代理保持存活直到退出。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Soft Subagent Request Budget","zh":"子代理软请求预算"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Soft per-subagent request budget (assistant requests per run). Crossing it injects a wrap-up steering notice (see task.softRequestBudgetNotice); at 1.5x the budget the run is force-stopped and the agent must yield its partial findings. 0 disables the guard. Bundled scout/sonic agents cap out at a lower built-in budget, so a value below that cap still applies to them.","zh":"每个子代理的软请求预算(每次运行的 assistant 请求数)。超过后注入收尾引导通知(见 task.softRequestBudgetNotice);达到预算的 1.5 倍时强制停止运行,代理必须交出部分发现。0 禁用该防护。内置的 scout/sonic 代理以较低的内置预算为上限,因此低于该上限的值仍然适用于它们。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"90 requests","zh":"90 次请求"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"150 requests","zh":"150 次请求"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"200 requests","zh":"200 次请求"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Soft Request Budget Notice","zh":"软请求预算通知"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Inject one steering notice when a subagent crosses its soft request budget, asking it to wrap up before the 1.5x forced-yield stop.","zh":"当子代理超过其软请求预算时注入一条引导通知,要求它在 1.5 倍强制让出停止之前收尾。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum Per-Spawn Effort","zh":"每次派生的最大思考力度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum reasoning effort allowed for the task tool's per-spawn effort hint. Lower values prevent callers from escalating subagents above this ceiling; the default preserves the model's full range.","zh":"task 工具每次派生 effort 提示所允许的最大推理力度。较低的值可防止调用方将子代理提升到该上限之上;默认保留模型的全部范围。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Generic Task Prewalk","zh":"通用任务 Prewalk"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Todo Auto-Clear Delay","zh":"待办自动清除延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Delay before completed or abandoned todos are removed from the todo widget","zh":"已完成或放弃的待办从待办组件移除前的延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Instant","zh":"立即"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show Resolved Model Badge","zh":"显示解析后的模型徽章"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Display the actual model ID used by each subagent in the task widget status line","zh":"在 task 组件状态栏中显示每个子代理实际使用的模型 ID"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Skill Commands","zh":"技能命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Register skills as /skill:name commands","zh":"将技能注册为 /skill:name 命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Claude User Commands","zh":"Claude 用户命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load commands from ~/.claude/commands/","zh":"从 ~/.claude/commands/ 加载命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Claude Project Commands","zh":"Claude 项目命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load commands from .claude/commands/","zh":"从 .claude/commands/ 加载命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"OpenCode User Commands","zh":"OpenCode 用户命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load commands from ~/.config/opencode/commands/","zh":"从 ~/.config/opencode/commands/ 加载命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"OpenCode Project Commands","zh":"OpenCode 项目命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Load commands from .opencode/commands/","zh":"从 .opencode/commands/ 加载命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Hide Secrets","zh":"隐藏机密"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Obfuscate configured secrets and redact credential-shaped tokens before sending to AI providers","zh":"在发送给 AI 提供商之前,混淆已配置的机密并脱敏形似 credential 的 tokens"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ollama Cloud Max Concurrency","zh":"Ollama Cloud 最大并发数"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Maximum concurrent Ollama Cloud subagent runs per process; 0 disables the provider-specific limit","zh":"每个进程的 Ollama Cloud 子代理最大并发运行数;0 禁用该提供商特定限制"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Web Search Provider Order","zh":"Web 搜索提供商顺序"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prioritized providers for the web_search tool; unlisted providers retain their default order afterward","zh":"web_search 工具的优先级提供商列表;未列出的提供商之后保持默认顺序"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Excluded Web Search Providers","zh":"排除的 Web 搜索提供商"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Providers that web_search should never use, even as fallbacks","zh":"web_search 绝不使用的提供商,即使作为回退"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Web Search Timeout","zh":"Web 搜索超时"},
		{"kind":"template","file":"src/config/settings-schema.ts","en":"Hard timeout for each provider's search transport before web_search advances to the next fallback, in seconds (maximum ${MAX_WEB_SEARCH_TIMEOUT_SECONDS})","zh":"web_search 前进到下一个回退前,每个提供商搜索传输的硬超时(秒)(最大 ${MAX_WEB_SEARCH_TIMEOUT_SECONDS})"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Gemini web_search model","zh":"Gemini web_search 模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Model ID for Gemini Google Search grounding. Defaults to gemini-2.5-flash.","zh":"Gemini Google Search grounding 的模型 ID。默认为 gemini-2.5-flash。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Antigravity Endpoint Mode","zh":"Antigravity 端点模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Endpoint routing strategy for google-antigravity providers (chat, search, image, discovery)","zh":"google-antigravity 提供商的端点路由策略(chat、search、image、discovery)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Try production endpoint, fail over to sandbox on 5xx/429","zh":"尝试生产端点,5xx/429 时故障转移到沙箱"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Production Only","zh":"仅生产"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Force production endpoint only","zh":"仅强制使用生产端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Sandbox Only","zh":"仅沙箱"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Force sandbox endpoint only","zh":"仅强制使用沙箱端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image Provider Order","zh":"图片提供商顺序"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prioritized providers for image generation; unlisted providers follow the active session provider and the built-in order","zh":"图片生成的优先级提供商列表;未列出的提供商遵循当前会话提供商和内置顺序"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fireworks Tier","zh":"Fireworks 层级"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Serving path for Fireworks requests. Priority sends `service_tier: \"priority\"` for higher reliability during peak traffic at a higher price; Standard omits it. Fast (`-fast`) models ignore this — Fast is its own serving path.","zh":"Fireworks 请求的服务路径。Priority 发送 `service_tier: “priority”` 以在高峰流量期间以更高价格换取更高可靠性;Standard 省略它。Fast (`-fast`) 模型忽略此项——Fast 有它自己的服务路径。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Standard","zh":"标准"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default serving path (no service_tier)","zh":"默认服务路径(无 service_tier)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Priority","zh":"优先"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Priority serving path: higher reliability, premium per-token pricing","zh":"优先服务路径:更高可靠性,按 token 溢价计费"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Live Voice","zh":"实时语音"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Voice used by Codex-backed realtime voice sessions","zh":"Codex 驱动的实时语音会话使用的语音"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Text-to-Speech Provider","zh":"文本转语音提供商"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prefer local on-device TTS; route .mp3 output to xAI when credentials exist","zh":"优先使用本地设备端 TTS;存在 credentials 时将 .mp3 输出路由到 xAI"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"On-device neural TTS (Kokoro-82M); output is WAV/PCM16","zh":"设备端神经 TTS (Kokoro-82M);输出为 WAV/PCM16"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Requires xAI Grok OAuth or XAI_API_KEY; MP3 or WAV","zh":"需要 xAI Grok OAuth 或 XAI_API_KEY;MP3 或 WAV"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local TTS Model","zh":"本地 TTS 模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"On-device neural TTS model (Kokoro-82M) used by the local TTS backend","zh":"本地 TTS 后端使用的设备端神经 TTS 模型 (Kokoro-82M)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local TTS Voice","zh":"本地 TTS 语音"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Kokoro voice used by the local TTS backend (American/British, female/male)","zh":"本地 TTS 后端使用的 Kokoro 语音(美式/英式,女声/男声)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech Vocalization","zh":"语音朗读"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speak the assistant's output aloud through the speakers as it streams","zh":"在流式输出时通过扬声器朗读助手输出"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech Vocalization Mode","zh":"语音朗读模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"What to speak: all = assistant messages + thinking; assistant = messages only; yield = only the final message at turn end","zh":"朗读什么:all = 助手消息 + 思考;assistant = 仅消息;yield = 仅轮次结束时的最后一条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"All (messages + thinking)","zh":"全部(消息 + 思考)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Assistant messages","zh":"仅助手消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Final message only","zh":"仅最后一条消息"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enhanced Speech Rewriting","zh":"增强语音改写"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Rewrite assistant output into natural spoken prose with the tiny/smol model before synthesis (describes code, drops links and markdown). Falls back to mechanical cleanup on failure","zh":"在合成前用 tiny/smol 模型将助手输出改写为自然的朗读文本(描述代码,丢弃链接和 markdown)。失败时回退到机械清理"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech Vocalization Voice","zh":"语音朗读音色"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Kokoro voice used when speaking the assistant's output aloud","zh":"朗读助手输出时使用的 Kokoro 语音"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Session-title model: online (the TINY role from /models, else @smol) by default, or a local on-device model","zh":"会话标题模型:默认使用在线模型(来自 /models 的 TINY 角色,否则为 @smol),或使用本地设备端模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Tiny Model Device","zh":"小模型设备"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Tiny Model Precision","zh":"小模型精度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Memory Model","zh":"记忆模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mnemopi LLM for fact extraction + consolidation: online (the TINY role from /models, else smol/remote) by default, or a local on-device model","zh":"用于事实提取 + 整合的 Mnemopi LLM:默认使用在线模型(来自 /models 的 TINY 角色,否则为 smol/remote),或使用本地设备端模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto Thinking Model","zh":"自动思考模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Difficulty classifier for the `auto` thinking level: online (the TINY role from /models, else smol) by default, or a local on-device model","zh":"`auto` 思考级别的难度分类器:默认使用在线模型(来自 /models 的 TINY 角色,否则为 smol),或使用本地设备端模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto Thinking Ceiling","zh":"自动思考上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Highest effort the `auto` classifier may resolve. `xhigh` keeps the classifier one tier below the top, so only an explicit `ultrathink` reaches `max`; `max` lets a turn the classifier judges exceptional bill the top tier on models that expose it.","zh":"`auto` 分类器可解析的最高档位。`xhigh` 让分类器比最高档低一档,因此只有显式的 `ultrathink` 才能达到 `max`;`max` 允许分类器判定为例外的一轮,在支持的模型上计入最高档费用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Classifier stops at xhigh (default)","zh":"分类器在 xhigh 处停止(默认)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Classifier may resolve max where the model supports it","zh":"在模型支持的情况下,分类器可解析为 max"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Unexpected Stop Model","zh":"意外停止检测模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Kimi API Format","zh":"Kimi API 格式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"API format for Kimi Code provider (auto follows live model metadata)","zh":"Kimi Code 提供商的 API 格式(auto 跟随模型实时元数据)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the model's server-declared protocol","zh":"使用模型服务端声明的协议"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Websocket policy for OpenAI Codex models (auto uses model defaults, on forces, off disables)","zh":"OpenAI Codex 模型的 websocket 策略(auto 使用模型默认,on 强制,off 禁用)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use model/provider default websocket behavior","zh":"使用模型/提供商默认 websocket 行为"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disable websockets for OpenAI Codex models","zh":"禁用 OpenAI Codex 模型的 websockets"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Force websockets for OpenAI Codex models","zh":"强制 OpenAI Codex 模型使用 websockets"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Stream First Event Timeout","zh":"流首事件超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Seconds to wait for the first model stream event; -1 uses provider/env defaults, 0 disables the watchdog","zh":"等待模型流第一个事件的秒数;-1 使用提供商/环境默认值,0 禁用看门狗"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use provider defaults and PI_* timeout env vars","zh":"使用提供商默认值和 PI_* 超时环境变量"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disable first-event timeout","zh":"禁用首事件超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Stream Idle Timeout","zh":"流空闲超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Seconds a model stream may stay silent between events; -1 uses provider/env defaults, 0 disables the watchdog","zh":"模型流在事件之间可保持静默的秒数;-1 使用提供商/环境默认值,0 禁用看门狗"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disable idle timeout","zh":"禁用空闲超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"OpenRouter Routing","zh":"OpenRouter 路由"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Default routing-variant suffix appended to OpenRouter model IDs (overridden when the selector already names a variant)","zh":"追加到 OpenRouter 模型 ID 的默认路由变体后缀(选择器已指定变体时覆盖)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"No suffix; use OpenRouter's default routing","zh":"无后缀;使用 OpenRouter 默认路由"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prioritize throughput / lowest latency","zh":"优先吞吐量 / 最低延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Prioritize cheapest available provider","zh":"优先最便宜的可用提供商"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable OpenRouter's web-search plugin","zh":"启用 OpenRouter 的 web-search 插件"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Cherry-picked high-quality providers (only defined for select models)","zh":"精选的高质量提供商(仅为特定模型定义)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fetch Provider","zh":"抓取提供商"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Reader backend priority for the fetch/read URL tool","zh":"fetch/read URL 工具的阅读器后端优先级"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"In-process HTML→Markdown converter (always available)","zh":"进程内 HTML→Markdown 转换器(始终可用)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-installs via uv/pip","zh":"通过 uv/pip 自动安装"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Requires lynx system package","zh":"需要 lynx 系统包"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Requires PARALLEL_API_KEY","zh":"需要 PARALLEL_API_KEY"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Uses r.jina.ai reader (JINA_API_KEY optional)","zh":"使用 r.jina.ai 阅读器(JINA_API_KEY 可选)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Auto-Redeem Saved Resets","zh":"Codex 自动赎回保存的重置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Spend saved Codex rate-limit resets automatically: restore an account blocked by an exhausted 5h or weekly window when a turn is stuck and no other account can take over, and salvage credits that are about to expire. unset asks before the first spend, yes spends without prompting, and no disables both checks.","zh":"自动花费保存的 Codex 限流重置:当一轮卡住且没有其他账户可接管时,恢复被耗尽的 5 小时或每周窗口阻止的账户,并抢救即将过期的额度。unset 在首次花费前询问,yes 不加提示直接花费,no 禁用这两项检查。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Unset","zh":"未设置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Check eligibility, then ask before spending the first saved reset.","zh":"检查资格,然后在花费第一个保存的重置前询问。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Yes","zh":"是"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Spend eligible saved resets without prompting.","zh":"不加提示地花费符合条件的保存重置。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"No","zh":"否"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Do not run the saved-reset auto-redeem check.","zh":"不运行保存重置自动赎回检查。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Auto-Redeem Min Block","zh":"Codex 自动赎回最小阻塞"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Only auto-redeem when the natural unblock — the latest reset among the exhausted 5h/weekly windows — is at least this many minutes away (don't spend a scarce credit to save a short wait). Raise it (e.g. 360) to ignore 5h-only blocks.","zh":"仅当自然解锁——耗尽的 5 小时/每周窗口中最近的重置——至少还有这么多分钟时才自动赎回(不要为了省一次短暂的等待而花费稀缺额度)。调高它(例如 360)可忽略仅 5 小时的阻塞。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Auto-Redeem Reserve","zh":"Codex 自动赎回储备"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Never auto-spend below this many saved resets (0 = the last credit may be spent automatically). Credits about to expire are exempt — a reserved credit that expires preserves nothing.","zh":"绝不低于这个数量地自动花费保存的重置(0 = 最后一份额度也可能被自动花费)。即将过期的额度除外——保留的额度过期也不保留任何东西。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Reset Salvage Horizon","zh":"Codex 重置抢救时限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Spend a saved Codex reset automatically when it would otherwise expire within this many hours and either chat window (5h or weekly) has meaningful usage to restore (0 disables expiry salvage).","zh":"当保存的 Codex 重置将在这么多小时内过期,且任一聊天窗口(5 小时或每周)有值得恢复的用量时,自动花费它(0 禁用过期抢救)。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Append-Only Context","zh":"仅追加上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Cache system prompt + tool specs and keep an append-only message log so provider prefix caches (DeepSeek, Xiaomi/SGLang, Anthropic) hit at maximum rate. Auto enables for known prefix-cache providers.","zh":"缓存系统提示 + 工具规格,并保持仅追加的消息日志,使提供商前缀缓存(DeepSeek、Xiaomi/SGLang、Anthropic)以最大命中率工作。Auto 对已知的前缀缓存提供商启用。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable for known prefix-cache providers (recommended)","zh":"对已知的前缀缓存提供商启用(推荐)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Always enable append-only context","zh":"始终启用仅追加上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Disable append-only context","zh":"禁用仅追加上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Exa Search Delay","zh":"Exa 搜索延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Minimum delay between Exa web search requests in milliseconds; set 0 to disable pacing","zh":"Exa 网页搜索请求之间的最小延迟(毫秒);设为 0 禁用限速"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"SearXNG Endpoint","zh":"SearXNG 端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Base URL of a self-hosted SearXNG instance used for web search","zh":"用于网页搜索的自托管 SearXNG 实例的基础 URL"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto QA","zh":"自动 QA"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automated tool issue reporting (xd://report_issue). On by default; the first report asks for consent, and denying it disables reporting until re-enabled explicitly","zh":"自动化工具问题上报 (xd://report_issue)。默认开启;首次上报会征求同意,拒绝后会禁用上报,直到显式重新启用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto QA Push Endpoint","zh":"自动 QA 推送端点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Full URL receiving Auto QA JSON reports (default https://qa.omp.sh/v1/grievances)","zh":"接收自动 QA JSON 上报的完整 URL(默认 https://qa.omp.sh/v1/grievances)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Status Band (Default)","zh":"状态带（默认）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Flush soft-capped status band above a curved prompt, no frame","zh":"弯曲提示符上方平顶软上限状态带，无边框"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Rounded Box","zh":"圆角框"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Status line embedded in top border, compact 2-line prompt","zh":"状态行嵌入上边框，紧凑两行提示符"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Full-width horizontal rules above and below, status line at bottom","zh":"上下通栏横线，状态行在底部"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Framed horizontal rules with status line at bottom","zh":"框式横线，状态行在底部"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Borderless","zh":"无边框"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Clean prompt glyph with status line at bottom, no box borders","zh":"简洁提示符字形，状态行在底部，无框"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Top Rule Dock","zh":"顶栏停靠"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Single top rule with status docked onto it and below","zh":"单条顶部横线，状态停靠其上与其下"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compact Field","zh":"紧凑输入场"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Filled one-row field with accent end caps","zh":"单行填充输入场，两端强调收尾"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Accent Rail","zh":"强调轨道"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Filled one-row field anchored by a single accent rail","zh":"由单条强调轨道锚定的单行填充输入场"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Composer","zh":"输入框"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Power","zh":"电源"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `read` tool instead of cat/head/tail. It provides better context and handles binary files.","zh":"用 `read` 工具替代 cat/head/tail。上下文更完整，并能处理二进制文件。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `grep` tool instead of grep/rg. It respects .gitignore and provides structured output.","zh":"用 `grep` 工具替代 grep/rg。遵循 .gitignore 并提供结构化输出。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `glob` tool instead of find/fd. It respects .gitignore and is faster for glob patterns.","zh":"用 `glob` 工具替代 find/fd。遵循 .gitignore，且 glob 匹配更快。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `edit` tool instead of sed -i. It provides diff preview and fuzzy matching.","zh":"用 `edit` 工具替代 sed -i。提供 diff 预览与模糊匹配。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `edit` tool instead of perl -i. It provides diff preview and fuzzy matching.","zh":"用 `edit` 工具替代 perl -i。提供 diff 预览与模糊匹配。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `edit` tool instead of awk -i inplace. It provides diff preview and fuzzy matching.","zh":"用 `edit` 工具替代 awk -i inplace。提供 diff 预览与模糊匹配。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `write` tool instead of echo/cat redirection. It handles encoding and provides confirmation.","zh":"用 `write` 工具替代 echo/cat 重定向。正确处理编码并需确认。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use the `hub` tool (`op:\"start\"`) for watch mode so its output, input, and lifecycle stay managed.","zh":"watch 模式请用 `hub` 工具（`op:\"start\"`），其输出、输入与生命周期都会被托管。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Keep the system awake while a session is open (macOS `caffeinate -i`)","zh":"会话开启期间保持系统唤醒（macOS `caffeinate -i`）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Also keep the display from idle-sleeping (macOS `caffeinate -i -d`)","zh":"同时防止显示器空闲休眠（macOS `caffeinate -i -d`）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Code Mode","zh":"Codex 代码模式"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Codex Code Mode Direct Tools","zh":"Codex 代码模式直接工具"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Composer Shape","zh":"输入框形状"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Visual layout of the input editor and status line","zh":"输入编辑器与状态行的视觉布局"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Context-Reactive Line","zh":"上下文感应线"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How the line between the left and right segments reflects context usage (box composer only)","zh":"左右两段之间的横线如何反映上下文占用（仅框式输入框）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Solid accent line, no context feedback","zh":"实色强调线，不反馈上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Percentage","zh":"百分比"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Used portion in accent color, remainder dimmed","zh":"已用部分用强调色，其余置暗"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Annotated","zh":"带刻度"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Percentage plus ticks at the speculative and auto-compaction boundaries","zh":"百分比加刻度，标出投机压缩与自动压缩边界"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Embedded","zh":"内嵌"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Annotated line with the context percentage and window embedded in the gauge","zh":"带刻度线，把上下文百分比与窗口内嵌进仪表"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Serve Images as URLs","zh":"以 URL 提供图片"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL Backends","zh":"图片 URL 后端"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ordered destinations tried when publishing images for provider access","zh":"发布图片供模型访问时按序尝试的目标"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image Upload Command","zh":"图片上传命令"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL Public Base","zh":"图片 URL 公网基址"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Externally reachable base URL fronting the blob server (required for ssh, optional for direct)","zh":"blob 服务器对外可访问的基址（ssh 必需，直连可选）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL Lifetime (hours)","zh":"图片 URL 有效期（小时）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL Bind Host","zh":"图片 URL 绑定主机"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Host the blob server binds to; loopback for tunnels, 0.0.0.0 for direct serving","zh":"blob 服务器绑定主机；隧道用 loopback，直接对外用 0.0.0.0"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL SSH Target","zh":"图片 URL SSH 目标"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"user@host destination for the ssh reverse forward","zh":"ssh 反向转发目标（user@host）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Image URL SSH Remote Port","zh":"图片 URL SSH 远程端口"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Remote listen port of the ssh reverse forward that your web server proxies to","zh":"ssh 反向转发在远端监听、由你的 Web 服务器代理的端口"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Resize Scrollback","zh":"尺寸调整时的回滚"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"How a settled terminal resize refreshes transcript rows retained in terminal scrollback","zh":"终端尺寸稳定后，如何刷新回滚缓冲中保留的会话记录行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Append","zh":"追加"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Replay the transcript at the new width below retained history","zh":"以新宽度在保留历史之下重放会话记录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Rebuild","zh":"重建"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Erase all terminal scrollback, then replay one current-width transcript","zh":"清空全部回滚缓冲，再以当前宽度重放一遍会话记录"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Preserve","zh":"保留"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Repaint only the viewport and keep history wrapped at its old width","zh":"仅重绘视口，历史按旧宽度保留换行"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Agent Reactions","zh":"代理表情回应"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Invite the agent to react to your message with an emoji badge on its bubble","zh":"让代理在你的消息气泡上以 emoji 徽章回应"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show Turn Time","zh":"显示轮次耗时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show the total prompt-to-yield time (including tool calls) on assistant message usage rows","zh":"在助手消息用量行显示从提示到产出的总耗时（含工具调用）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show a divider after an assistant turn whose request lost (missed) the prompt cache","zh":"在未命中提示缓存的助手轮次后显示分隔线"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"External Thinking","zh":"外部思考"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Private scratchpad; not shown to user. Disables supported GPT, Claude, and Gemini reasoning","zh":"私有草稿区，不展示给用户；会禁用受支持的 GPT/Claude/Gemini 推理"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"List Skills in Prompt","zh":"在提示中列出技能"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Wait For Usage Reset","zh":"等待用量重置"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Typo Detection (macOS)","zh":"拼写检查（macOS）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mark misspelled prompt words with the active macOS dictionaries","zh":"用启用的 macOS 词典标记输入中的拼写错误"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Word Autocomplete (macOS)","zh":"单词自动补全（macOS）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Show macOS dictionary word completions as inline hints accepted with Tab","zh":"以行内提示显示 macOS 词典补全，按 Tab 接受"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Autocorrect (macOS)","zh":"自动纠错（macOS）"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Apply confident macOS spelling corrections after completed words","zh":"在完成输入的单词后应用有把握的 macOS 纠错"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Update Channel","zh":"更新通道"},
