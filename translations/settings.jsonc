		{"kind":"string","file":"src/config/settings-schema.ts","en":"Extended Context","zh":"扩展上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compaction Method Order","zh":"压缩方式顺序"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1/8 of a 200K window","zh":"200K 窗口的 1/8"},
