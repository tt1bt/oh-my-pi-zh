		{"kind":"string","file":"src/config/settings-schema.ts","en":"Stable","zh":"稳定版"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Canary","zh":"Canary 预览版"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Relay URL","zh":"中继 URL"},
