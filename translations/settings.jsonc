		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ask Timeout","zh":"询问超时"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-select the recommended ask option after this many seconds (0 disables)","zh":"经过这么多秒后自动选择推荐的 ask 选项(0 禁用)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"15 seconds","zh":"15 秒"},
