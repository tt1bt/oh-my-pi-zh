		{"kind":"string","file":"src/config/settings-schema.ts","en":"120 seconds","zh":"120 秒"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Ask Notification","zh":"询问通知"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Notify when the ask tool is waiting for input","zh":"ask 工具等待输入时通知"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Idle Recap","zh":"空闲回顾"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Generate a brief LLM recap of where things stand after the terminal has been idle","zh":"终端空闲一段时间后,生成一份简短的 LLM 回顾,说明当前进展"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Idle Recap Delay","zh":"空闲回顾延迟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Seconds to wait while idle before showing the recap","zh":"空闲后等待多少秒再显示回顾"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"1 minute","zh":"1 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"2 minutes","zh":"2 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"4 minutes","zh":"4 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"5 minutes","zh":"5 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"10 minutes","zh":"10 分钟"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Relay used by /collab (wss://host[:port])","zh":"/collab 使用的 relay (wss://host[:port])"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Browser UI used by /collab links; empty derives from collab.relayUrl; explicit http:// is localhost-only","zh":"/collab 链接使用的浏览器 UI;留空则从 collab.relayUrl 派生;显式 http:// 仅限 localhost"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Display Name","zh":"显示名称"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Name shown to other collab participants (default: OS username)","zh":"向其他协作参与者显示的名称(默认:OS 用户名)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Share Server","zh":"分享服务器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Share viewer/upload base used by /share (encrypted blob upload + viewer; links are <base>/<id>#<key>)","zh":"/share 使用的分享查看/上传基址(加密 blob 上传 + 查看器;链接为 <base>/<id>#<key>)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Share Store","zh":"分享存储"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Where /share uploads the encrypted session blob","zh":"/share 将加密的会话 blob 上传到哪里"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Encrypted Blob","zh":"加密 Blob"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Upload to the share server (no GitHub account needed; avoids gist API rate limits)","zh":"上传到分享服务器(无需 GitHub 账户;避免 gist API 限流)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Push to a secret gist (needs authenticated gh), falling back to the share server","zh":"推送到 secret gist(需要已认证的 gh),失败时回退到分享服务器"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Share Secret Redaction","zh":"分享机密脱敏"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Run the secret obfuscator over /share snapshots before upload (uses the secrets.* config)","zh":"上传前对 /share 快照运行机密混淆器(使用 secrets.* 配置)"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech-to-Text","zh":"语音转文字"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Enable speech-to-text input via microphone","zh":"通过麦克风启用语音转文字输入"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech Model","zh":"语音模型"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Local on-device speech model. Parakeet TDT v3 (sherpa-onnx) is the SoTA default; Whisper base/small/large-v3-turbo tiers (transformers.js) trade size for multilingual coverage. Downloaded on first use.","zh":"本地设备端语音模型。Parakeet TDT v3 (sherpa-onnx) 是 SoTA 默认;Whisper base/small/large-v3-turbo 各档(transformers.js)以体积换取多语言覆盖。首次使用时下载。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Speech-to-Text Submit Trigger","zh":"语音转文字提交触发"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Choose when speech dictation automatically submits: Never, Release (2+ words), Release with complete sentence, or When I Say Submit.","zh":"选择语音听写何时自动提交:从不、松开(2 个以上词)、松开并完成整句,或当我说提交时。"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-Promote Context","zh":"自动提升上下文"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Promote to a larger-context model on context overflow instead of compacting","zh":"上下文溢出时提升到更大上下文的模型,而不是压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Auto-Compact","zh":"自动压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Automatically compact context when it gets too large","zh":"上下文过大时自动压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Mid-Turn Compaction","zh":"轮中压缩"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Check thresholds at safe mid-turn tool-loop boundaries before the next provider request","zh":"在下一次提供商请求之前,于安全的轮中工具循环边界检查阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compaction Threshold","zh":"压缩阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Percent threshold for context maintenance; set to Default to use legacy reserve-based behavior","zh":"上下文维护的百分比阈值;设为默认以使用旧的基于预留的行为"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Legacy reserve-based threshold","zh":"旧的基于预留的阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Extremely early maintenance","zh":"极早维护"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Very early maintenance","zh":"很早维护"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Early maintenance","zh":"较早维护"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Moderately early maintenance","zh":"中等偏早维护"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Halfway point","zh":"中点"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Moderate context usage","zh":"中等上下文占用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Slightly aggressive","zh":"略激进"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Typical threshold","zh":"典型阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Aggressive context usage","zh":"激进的上下文占用"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Very aggressive","zh":"非常激进"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Near context limit","zh":"接近上下文上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Compaction Token Limit","zh":"压缩 Token 上限"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Fixed token limit for context maintenance; overrides percentage if set","zh":"上下文维护的固定 token 上限;设置后覆盖百分比"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Use percentage-based threshold","zh":"使用基于百分比的阈值"},
		{"kind":"string","file":"src/config/settings-schema.ts","en":"Full standard context window","zh":"完整标准上下文窗口"},
