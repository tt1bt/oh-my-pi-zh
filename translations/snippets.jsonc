		{"kind":"snippet","file":"src/tools/render-utils.ts","name":"block@-142+142#7","find":"export { formatAge, formatBytes, formatCount, formatDuration, pluralize } from \"@oh-my-pi/pi-utils\";","replace":"export { formatAge, formatBytes, formatDuration, pluralize } from \"@oh-my-pi/pi-utils\";\n\n/** English unit word → 中文量词,used by `formatCount`/`formatMoreItems` so\n *  renderers can keep passing short English unit keys while the UI reads\n *  naturally in Chinese. Unknown keys pass through unchanged. */\nconst COUNT_UNIT_ZH: Record<string, string> = {\n\tfile: \"个文件\",\n\tmatch: \"处匹配\",\n\titem: \"项\",\n\tline: \"行\",\n\treplacement: \"处替换\",\n\ttodo: \"个任务\",\n\ttask: \"个任务\",\n\tprocess: \"个进程\",\n\tagent: \"个代理\",\n\tmessage: \"条消息\",\n\tjob: \"个任务\",\n\tphase: \"个阶段\",\n\tyield: \"个结果\",\n\tfinding: \"项发现\",\n\tchange: \"处更改\",\n\thunk: \"个 hunk\",\n};\n\n/** Count with a Chinese unit, e.g. `3 个文件` / `1 处匹配`. */\nexport function formatCount(label: string, count: number): string {\n\tconst safeCount = Number.isFinite(count) ? count : 0;\n\treturn `${safeCount} ${COUNT_UNIT_ZH[label] ?? label}`;\n}","note":"hunk @@ -142,7 +142,35"},
		{"kind":"snippet","file":"src/tools/vibe.ts","name":"insert@-326+326#8","find":"\t\t\treturn \"muted\";\n\t}\n}\n","replace":"\t\t\treturn \"muted\";\n\t}\n}\n\n/** Displayed copy of a session state (the semantic value stays in `screen.state`). */\nfunction sessionStateLabel(state: VibeSessionState): string {\n\tswitch (state) {\n\t\tcase \"starting\":\n\t\t\treturn \"启动中\";\n\t\tcase \"running\":\n\t\t\treturn \"运行中\";\n\t\tcase \"idle\":\n\t\t\treturn \"空闲\";\n\t\tcase \"dead\":\n\t\t\treturn \"已退出\";\n\t}\n}\n\n/** Displayed copy of a settled turn status (the semantic value stays in the event). */\nfunction settledStatusLabel(status: \"completed\" | \"failed\" | \"cancelled\"): string {\n\tswitch (status) {\n\t\tcase \"completed\":\n\t\t\treturn \"已完成\";\n\t\tcase \"failed\":\n\t\t\treturn \"失败\";\n\t\tcase \"cancelled\":\n\t\t\treturn \"已取消\";\n\t}\n}\n","note":"hunk @@ -326,6 +326,32"},
