		{"kind":"template","file":"src/tools/hub.ts","en":"Wait timed out — still waiting on ${waitPendingSummary(daemon, params).join(\"; \")}.","zh":"等待超时 —— 仍在等待 ${waitPendingSummary(daemon, params).join(\"; \")}。","pkg":"tui"},
		{"kind":"template","file":"src/tools/hub.ts","en":"output pattern /${params.pattern}/ never matched","zh":"输出模式 /${params.pattern}/ 从未匹配","pkg":"tui"},
